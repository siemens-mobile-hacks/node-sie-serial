{
	"compilerOptions": {
		"rootDir": ".",
		"outDir": "./dist",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"target": "ESNext",
		"lib": ["ESNext"],
		"types": ["node"],
		"paths": {
			"@sie-js/serial": ["./src/index.ts"],
			"#src/*": ["./src/*"],
			"#tests/*": ["./tests/*"]
		},
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,
		"strict": true,
		"noUncheckedSideEffectImports": true,
		"moduleDetection": "force",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true
	},
	"include": ["src", "examples", "tests", "tools", "mmu.ts"],
	"exclude": ["node_modules", "dist"]
}
